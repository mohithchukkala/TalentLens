        "smooth_idf": "True",
        "norm": "l2",
        "min_df": "1",
        "max_df": "1.0"
      }
    },
    "B_semantic": {
      "model": "sentence-transformers/all-MiniLM-L6-v2",
      "device": "cpu",
      "max_seq_length": 256,
      "chunk_tokens": 200,
      "overlap_tokens": 40,
      "top_k": 1,
      "aggregation": "JD-chunk-token-weighted mean of best resume-chunk cosine",
      "ranked_by": "raw cosine (not clipped)"
    },
    "C_combined": {
      "weights": {
        "semantic": 0.5,
        "tfidf": 0.2,
        "skills": 0.3
      },
      "formula": "0.50*max(0,semantic) + 0.20*tfidf + 0.30*required_skill_coverage"
    }
  },
  "metrics": {
